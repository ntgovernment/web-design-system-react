{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "component-icons.schema.json",
  "title": "DXP Component Icon Schema",
  "description": "Validates icon configurations for Squiz DXP component manifests. Icons use Font Awesome icon IDs (without the 'fa-' prefix). NT Gov Design System renders icons as 'fa-light fa-{id}'.",
  "type": "object",
  "required": ["id", "color"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Font Awesome icon ID without the 'fa-' prefix (e.g. 'web', 'code', 'user', 'grid'). NOT full class names like 'fa-light fa-code'.",
      "examples": [
        "web",
        "code",
        "user",
        "grid",
        "layout",
        "puzzle-piece",
        "circle-info",
        "chart-bar",
        "file-lines",
        "link",
        "magnifying-glass",
        "bell",
        "gear",
        "house",
        "star",
        "heart",
        "check",
        "xmark",
        "arrow-right",
        "arrow-left",
        "chevron-right",
        "chevron-down",
        "envelope",
        "phone",
        "location-dot",
        "calendar",
        "clock",
        "image",
        "video",
        "music",
        "pen",
        "trash",
        "copy",
        "download",
        "upload",
        "share",
        "lock",
        "unlock",
        "shield",
        "eye",
        "eye-slash",
        "database",
        "server",
        "cloud",
        "wifi",
        "mobile",
        "desktop",
        "tablet",
        "print",
        "bookmark",
        "tag",
        "tags",
        "filter",
        "sort",
        "list",
        "table",
        "chart-line",
        "chart-pie"
      ]
    },
    "color": {
      "description": "Icon color — either a hex value or a named enum color from the DXP palette.",
      "oneOf": [
        {
          "type": "object",
          "title": "Hex color",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "hex"
            },
            "value": {
              "type": "string",
              "description": "Hex color value (e.g. '#0066cc').",
              "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
            }
          }
        },
        {
          "type": "object",
          "title": "Enum color",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "enum"
            },
            "value": {
              "type": "string",
              "description": "Named color from the DXP icon palette.",
              "enum": [
                "gray",
                "blue",
                "green",
                "orange",
                "red",
                "purple",
                "teal",
                "yellow",
                "pink"
              ]
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
