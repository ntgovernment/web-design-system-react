{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "ntg-web-design-system",
  "name": "header",
  "displayName": "Header",
  "description": "Site-wide header with NT Government branding, navigation, and optional search.",
  "icon": {
    "id": "web_asset",
    "color": {
      "type": "enum",
      "value": "blue"
    }
  },
  "type": "edge",
  "version": "1.0.4",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "string",
            "title": "Variant",
            "description": "Header layout variant. 'nt-gov-au' shows the NT.GOV.AU desert-rose logo only. 'agency-internet' shows the NT Government mono logo plus an agency title. 'other-site' is the same as agency-internet with distinct styling.",
            "enum": ["nt-gov-au", "agency-internet", "other-site"],
            "default": "agency-internet"
          },
          "agencyName": {
            "type": "string",
            "title": "Agency name",
            "description": "Agency or site name shown as the title link in 'agency-internet' and 'other-site' variants.",
            "default": "Department of Example"
          },
          "agencyHref": {
            "type": "string",
            "title": "Agency URL",
            "description": "URL the agency/site title links to.",
            "default": "/"
          },
          "logoAlt": {
            "type": "string",
            "title": "Logo alt text",
            "description": "Alt text for the logo image.",
            "default": "NT Government"
          },
          "navItems": {
            "type": "array",
            "title": "Navigation items",
            "description": "Top-level navigation items shown in the header.",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "title": "Label"
                },
                "href": {
                  "type": "string",
                  "title": "URL"
                },
                "icon": {
                  "type": "string",
                  "title": "Icon",
                  "description": "Optional Font Awesome icon class (e.g. 'fa-light fa-home')."
                },
                "active": {
                  "type": "boolean",
                  "title": "Active",
                  "default": false
                }
              },
              "required": ["label", "href"]
            },
            "default": [
              { "label": "About us", "href": "/about" },
              { "label": "Programs", "href": "/programs" },
              { "label": "Publications", "href": "/publications" },
              { "label": "Contact", "href": "/contact" }
            ]
          },
          "showSearch": {
            "type": "boolean",
            "title": "Show search",
            "description": "Whether to include a search bar.",
            "default": true
          },
          "searchVariant": {
            "type": "string",
            "title": "Search variant",
            "description": "'expanded' shows the full search bar; 'icon' shows a search icon that expands on click.",
            "enum": ["expanded", "icon"],
            "default": "expanded"
          },
          "searchPlaceholder": {
            "type": "string",
            "title": "Search placeholder",
            "default": "Search"
          },
          "searchAction": {
            "type": "string",
            "title": "Search form action",
            "description": "URL the search form GETs to. The search input uses the field name 'query'.",
            "default": "/search"
          }
        },
        "required": ["variant"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "nt-gov-au": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/nt-gov-au.data.json"
          }
        }
      }
    },
    "agency-internet": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/agency-internet.data.json"
          }
        }
      }
    },
    "other-site": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/other-site.data.json"
          }
        }
      }
    }
  }
}
