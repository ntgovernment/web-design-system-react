{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "ntg-web-design-system",
  "name": "callout",
  "displayName": "Callout",
  "description": "Informational callout with optional heading and prominent left border for highlighting important content.",
  "icon": {
    "id": "info",
    "color": {
      "type": "enum",
      "value": "blue"
    }
  },
  "type": "edge",
  "version": "1.0.0",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "title": "Heading",
            "description": "Optional heading text displayed at the top of the callout.",
            "default": ""
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Main content text displayed in the callout.",
            "default": "Important information goes here."
          }
        },
        "required": ["content"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "with-heading": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/with-heading.data.json"
          }
        }
      }
    },
    "without-heading": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/without-heading.data.json"
          }
        }
      }
    },
    "long-content": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/long-content.data.json"
          }
        }
      }
    }
  }
}
