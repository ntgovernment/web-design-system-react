{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "ntg-web-design-system",
  "name": "global-alert",
  "displayName": "Global Alert",
  "description": "Site-wide alert banner shown above the header. Use for emergencies, service disruptions, scheduled maintenance and other information that affects the entire site or all users. Limit to one global alert per site (up to three may be stacked if absolutely necessary).",
  "icon": {
    "id": "announcement",
    "color": {
      "type": "enum",
      "value": "orange"
    }
  },
  "type": "edge",
  "version": "0.1.0",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "string",
            "title": "Variant",
            "description": "Severity / visual variant. Use 'critical' only for immediate, significant threats.",
            "enum": ["info", "info-alt", "warning", "critical"],
            "default": "info"
          },
          "title": {
            "type": "string",
            "title": "Alert title",
            "description": "Short, scannable heading. Keep under ~60 characters.",
            "default": "Important update"
          },
          "description": {
            "type": "FormattedText",
            "title": "Alert description",
            "description": "Body copy. Supports inline HTML so an authored link can be embedded in the message.",
            "default": "<p>Service updates and important information for all users.</p>"
          },
          "dismissible": {
            "type": "boolean",
            "title": "Show dismiss button",
            "description": "Show a close (×) button. Note: dismissal is per-page-load only — the alert reappears on next visit.",
            "default": false
          },
          "dismissLabel": {
            "type": "string",
            "title": "Dismiss button aria-label",
            "description": "Accessible label for the dismiss button.",
            "default": "Dismiss alert"
          },
          "ctaText": {
            "type": "string",
            "title": "CTA button text",
            "description": "Optional call-to-action button label. Leave blank to hide the button.",
            "default": ""
          },
          "ctaHref": {
            "type": "string",
            "title": "CTA button URL",
            "description": "URL the CTA button links to. Required if CTA text is provided.",
            "default": ""
          }
        },
        "required": ["title", "description"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "info": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/info.data.json"
          }
        }
      }
    },
    "info-alt": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/info-alt.data.json"
          }
        }
      }
    },
    "warning": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/warning.data.json"
          }
        }
      }
    },
    "critical": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/critical.data.json"
          }
        }
      }
    },
    "dismissible": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/dismissible.data.json"
          }
        }
      }
    },
    "with-cta": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/with-cta.data.json"
          }
        }
      }
    },
    "complete": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/complete.data.json"
          }
        }
      }
    }
  }
}
