<div class="layout-full-width-section">
  {{#if zones.header}}
    <header class="layout-full-width-section__header">
      {{{zones.header}}}
    </header>
  {{/if}}
  {{#if zones.main}}
    <main class="layout-full-width-section__main">
      {{{zones.main}}}
    </main>
  {{/if}}
  {{#if zones.footer}}
    <footer class="layout-full-width-section__footer">
      {{{zones.footer}}}
    </footer>
  {{/if}}
</div>