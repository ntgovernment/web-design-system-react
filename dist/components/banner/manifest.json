{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "ntg-web-design-system",
  "name": "banner",
  "displayName": "Banner",
  "description": "Large page-header component for home and landing pages. Introduces a page with a title, optional description, call-to-action button, breadcrumbs, and popular/featured/related links. Supports a dark primary variant and a light secondary variant.",
  "icon": {
    "id": "wallpaper",
    "color": {
      "type": "enum",
      "value": "blue"
    }
  },
  "type": "edge",
  "version": "0.3.0",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "string",
            "title": "Variant",
            "description": "Visual style of the banner. 'primary' uses a dark background; 'secondary' uses a light shade background with a border divider.",
            "enum": ["primary", "secondary"],
            "default": "primary"
          },
          "title": {
            "type": "string",
            "title": "Page title",
            "description": "The main H1 heading displayed in the banner.",
            "default": "Page title"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Optional short description displayed below the title.",
            "default": "Optional short description of the page goal"
          },
          "ctaText": {
            "type": "string",
            "title": "CTA button text",
            "description": "Label for the call-to-action button. Leave blank to hide the button.",
            "default": "Call to action"
          },
          "ctaHref": {
            "type": "string",
            "title": "CTA button URL",
            "description": "URL the CTA button links to.",
            "default": "#"
          },
          "ctaVariant": {
            "type": "string",
            "title": "CTA button variant",
            "description": "Bootstrap button style. Defaults to 'secondary' for both primary and secondary banner variants.",
            "enum": ["primary", "secondary", "tertiary"],
            "default": "secondary"
          },
          "linksHeading": {
            "type": "string",
            "title": "Links section heading",
            "description": "Heading label for the links panel. Leave blank to hide the links section.",
            "enum": ["Popular", "Featured", "Related"],
            "default": "Popular"
          },
          "links": {
            "type": "array",
            "title": "Links",
            "description": "List of links shown in the links panel. Primary variant renders pill-style links; secondary variant renders a vertical link list.",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "title": "Label"
                },
                "href": {
                  "type": "string",
                  "title": "URL"
                }
              },
              "required": ["label", "href"]
            },
            "default": [
              { "label": "Bus timetables and maps", "href": "#" },
              { "label": "Check your rego", "href": "#" },
              { "label": "Find a Motor Vehicle Registry (MVR)", "href": "#" },
              { "label": "Government priorities", "href": "#" }
            ]
          },
          "breadcrumbs": {
            "type": "array",
            "title": "Breadcrumbs",
            "description": "Full breadcrumb trail. Mark the last item with 'isCurrent: true'. Takes precedence over the 'label'/'href' shortcut fields.",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "title": "Label"
                },
                "href": {
                  "type": "string",
                  "title": "URL"
                },
                "isCurrent": {
                  "type": "boolean",
                  "title": "Is current page"
                }
              },
              "required": ["label"]
            },
            "default": []
          },
          "label": {
            "type": "string",
            "title": "Breadcrumb parent label",
            "description": "Shortcut: label for the first breadcrumb item (e.g. 'Home'). A 'Current page' crumb is appended automatically. Ignored when 'breadcrumbs' array is provided.",
            "default": ""
          },
          "href": {
            "type": "string",
            "title": "Breadcrumb parent URL",
            "description": "Shortcut: URL for the first breadcrumb item. Used together with 'label'.",
            "default": ""
          },
          "showDecorative": {
            "type": "boolean",
            "title": "Show decorative background",
            "description": "Display the decorative SVG background element. Defaults to true for both variants.",
            "default": true
          }
        },
        "required": ["title"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "primary": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/primary.data.json"
          }
        }
      }
    },
    "primary-featured": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/primary-featured.data.json"
          }
        }
      }
    },
    "primary-related": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/primary-related.data.json"
          }
        }
      }
    },
    "secondary": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/secondary.data.json"
          }
        }
      }
    },
    "secondary-featured": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/secondary-featured.data.json"
          }
        }
      }
    },
    "without-decorative": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/without-decorative.data.json"
          }
        }
      }
    },
    "complete": {
      "functionData": {
        "main": {
          "wrapper": { "path": "previews/wrapper.html" },
          "inputData": {
            "type": "file",
            "path": "previews/complete.data.json"
          }
        }
      }
    }
  }
}
